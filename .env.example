# Copia este archivo como .env.local (en tu PC) o pon estas variables en Vercel.

# Clave inicial del panel /admin (después se cambia desde el panel)
ADMIN_PASSWORD=

# Clave para el cron externo que llama a /api/robot
CRON_SECRET=

# Dirección pública del sitio (para el mapa del sitio y Google)
NEXT_PUBLIC_SITE_URL=https://tudominio.com

# Base de datos en producción (Turso). En tu PC, si se dejan vacías, usa data/loteria.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
